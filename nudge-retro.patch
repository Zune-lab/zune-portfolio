diff --git a/src/projects/Projects.css b/src/projects/Projects.css
index 3a97fc0..7a4fe87 100644
--- a/src/projects/Projects.css
+++ b/src/projects/Projects.css
@@ -447,20 +447,20 @@
 .proj-tags button:hover { color: var(--text); border-color: var(--amber-dim); }
 .proj-tags button[aria-pressed='true'] { color: var(--amber); border-color: var(--amber); background: color-mix(in srgb, var(--amber) 10%, transparent); }
 .proj-shelf { position: relative; }
-.proj-nudge { position: absolute; top: 46%; z-index: 3; display: grid; place-items: center; width: 34px; height: 34px; padding: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 50%; background: var(--panel); color: var(--amber); transform: translateY(-50%); box-shadow: 0 6px 12px -6px rgba(0, 0, 0, 0.6); transition: color 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease), transform 0.15s var(--ease); }
-/* nền vàng loang từ tâm ra khi hover */
-.proj-nudge::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--amber); transform: scale(0); transition: transform 0.35s var(--ease); }
-/* hai mũi tên xếp cạnh nhau: hover thì mũi tên thứ nhất trượt ra, mũi tên thứ hai trượt vào */
-.proj-nudge-ico { position: relative; z-index: 1; display: flex; width: 36px; height: 16px; transition: transform 0.35s var(--ease); }
-.proj-nudge-ico svg { flex: none; width: 18px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
-.proj-nudge.l .proj-nudge-ico { transform: translateX(9px); }
-.proj-nudge.r .proj-nudge-ico { transform: translateX(-9px); }
-.proj-nudge.l:hover .proj-nudge-ico { transform: translateX(-9px); }
-.proj-nudge.r:hover .proj-nudge-ico { transform: translateX(9px); }
-.proj-nudge:hover { border-color: var(--amber); color: var(--bg); box-shadow: 0 0 14px -2px var(--amber), 0 6px 12px -6px rgba(0, 0, 0, 0.6); }
-.proj-nudge:hover::before { transform: scale(1.2); }
-.proj-nudge:active { transform: translateY(-50%) scale(0.9); }
-@media (prefers-reduced-motion: reduce) { .proj-nudge, .proj-nudge::before, .proj-nudge-ico { transition: none; } }
+/* nút đổi băng: phím cứng của máy game. Khối vuông viền dày, cạnh dưới dày như phím nhấn, mũi tên pixel màu hổ phách.
+   Hover: sáng hổ phách kiểu đèn CRT + mũi tên nhích từng nấc (steps); nhấn: phím lún xuống. */
+.proj-nudge { position: absolute; top: 46%; z-index: 3; display: grid; place-items: center; width: 34px; height: 38px; padding: 0; border: 1px solid var(--line); border-bottom-width: 1px; border-radius: 4px; background: linear-gradient(var(--panel), var(--inset)); color: var(--amber); transform: translateY(-50%); box-shadow: 0 4px 0 var(--line), 0 10px 14px -6px rgba(0, 0, 0, 0.7); transition: border-color 0.12s steps(2), box-shadow 0.12s steps(2), transform 0.06s steps(2); }
+.proj-nudge svg { width: 8px; height: 14px; fill: currentColor; shape-rendering: crispEdges; }
+.proj-nudge.l svg { transform: scaleX(-1); }
+.proj-nudge:hover { border-color: var(--amber); box-shadow: 0 4px 0 var(--amber-dim), 0 0 14px -2px var(--amber), 0 10px 14px -6px rgba(0, 0, 0, 0.7); }
+.proj-nudge:hover svg { filter: drop-shadow(0 0 4px var(--amber)); }
+.proj-nudge:active { transform: translateY(calc(-50% + 3px)); box-shadow: 0 1px 0 var(--amber-dim), 0 0 10px -2px var(--amber); }
+@media (prefers-reduced-motion: no-preference) {
+  .proj-nudge.l:hover svg { animation: proj-nudge-l 0.5s steps(2, jump-none) infinite alternate; }
+  .proj-nudge.r:hover svg { animation: proj-nudge-r 0.5s steps(2, jump-none) infinite alternate; }
+}
+@keyframes proj-nudge-l { to { transform: translateX(-3px) scaleX(-1); } }
+@keyframes proj-nudge-r { to { transform: translateX(3px); } }
 .proj-nudge.l { left: -6px; }
 .proj-nudge.r { right: -6px; }
 @media (hover: none) { .proj-nudge { display: none; } }
