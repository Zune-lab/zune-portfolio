diff --git a/src/components/home/CopyEmail/CopyEmail.css b/src/components/home/CopyEmail/CopyEmail.css
new file mode 100644
index 0000000..1873750
--- /dev/null
+++ b/src/components/home/CopyEmail/CopyEmail.css
@@ -0,0 +1,200 @@
+/* Email chip + copy button. Colors come from the theme vars, so it follows dark / light / time of day.
+   Idle: amber icon box. Hover/focus: icon box fills amber, a tooltip pops up. Copied: icon swaps to a check (green). */
+
+.copy-mail {
+  --cm-h: 42px;
+  --cm-on: #0a0c10; /* text/icon color on top of the amber / green fill */
+  position: relative;
+  display: inline-flex;
+  align-items: stretch;
+  max-width: 100%;
+  height: var(--cm-h);
+  padding: 0;
+  font-size: 13px;
+  color: var(--text);
+  background: var(--inset);
+  border: 1px solid var(--amber-dim);
+  border-radius: 8px;
+  cursor: pointer;
+  transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
+}
+.copy-mail:hover,
+.copy-mail:focus-visible {
+  border-color: var(--amber);
+  box-shadow: 0 0 0 3px color-mix(in srgb, var(--amber) 18%, transparent);
+}
+.copy-mail:focus-visible {
+  outline: 2px solid var(--amber);
+  outline-offset: 3px;
+}
+
+.copy-mail-addr {
+  display: flex;
+  align-items: center;
+  min-width: 0;
+  padding: 0 14px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  letter-spacing: 0.01em;
+}
+/* the leading "$ " keeps the terminal vibe, without being part of the copied text (it never was selectable) */
+.copy-mail-addr::before {
+  content: '$';
+  margin-right: 8px;
+  color: var(--green);
+}
+
+:root[data-theme='light'] .copy-mail {
+  --cm-on: #fffaf0; /* amber is dark brown in light theme, so the fill needs light text */
+}
+
+.copy-mail-ico {
+  position: relative;
+  flex: none;
+  display: grid;
+  place-items: center;
+  width: var(--cm-h);
+  margin: -1px -1px -1px 0; /* sit flush on the border */
+  color: var(--amber);
+  border-left: 1px solid var(--amber-dim);
+  border-radius: 0 8px 8px 0;
+  overflow: hidden;
+  isolation: isolate;
+  transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
+}
+/* amber fill wipes up from the bottom, same family as the Send button's wipe */
+.copy-mail-ico::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: var(--amber);
+  transform: translateY(101%);
+  transition: transform var(--dur-fast) var(--ease);
+}
+.copy-mail:hover .copy-mail-ico,
+.copy-mail:focus-visible .copy-mail-ico {
+  color: var(--cm-on);
+  border-color: var(--amber);
+}
+.copy-mail:hover .copy-mail-ico::before,
+.copy-mail:focus-visible .copy-mail-ico::before {
+  transform: translateY(0);
+}
+
+.copy-mail-svg {
+  grid-area: 1 / 1;
+  width: 18px;
+  height: 18px;
+  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
+}
+.copy-mail-check {
+  opacity: 0;
+  transform: scale(0.4) rotate(-20deg);
+}
+.copy-mail:hover .copy-mail-clip {
+  transform: translateY(-1px) rotate(-6deg);
+}
+
+/* copied */
+.copy-mail[data-copied='true'] {
+  border-color: var(--green);
+}
+.copy-mail[data-copied='true'] .copy-mail-ico {
+  color: var(--cm-on);
+  border-color: var(--green);
+}
+.copy-mail[data-copied='true'] .copy-mail-ico::before {
+  background: var(--green);
+  transform: translateY(0);
+}
+.copy-mail[data-copied='true'] .copy-mail-clip {
+  opacity: 0;
+  transform: scale(0.4) rotate(20deg);
+}
+.copy-mail[data-copied='true'] .copy-mail-check {
+  opacity: 1;
+  transform: scale(1) rotate(0);
+}
+
+/* tooltip: below the icon box (the comment line sits above the chip, so it would cover it there); swaps text instead of resizing so nothing jumps */
+.copy-mail-tip {
+  position: absolute;
+  right: 0;
+  top: calc(100% + 10px);
+  display: grid;
+  padding: 5px 9px;
+  font-size: 11.5px;
+  line-height: 1.2;
+  white-space: nowrap;
+  color: var(--cm-on);
+  background: var(--amber);
+  border-radius: 6px;
+  opacity: 0;
+  visibility: hidden;
+  transform: translateY(-6px);
+  pointer-events: none;
+  transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.2s;
+}
+.copy-mail-tip::after {
+  content: '';
+  position: absolute;
+  bottom: 100%;
+  right: calc(var(--cm-h) / 2 - 5px);
+  border: 5px solid transparent;
+  border-bottom-color: var(--amber);
+}
+.copy-mail-tip > span {
+  grid-area: 1 / 1;
+  text-align: center;
+  transition: opacity 0.15s ease;
+}
+.copy-mail-tip-done {
+  opacity: 0;
+}
+.copy-mail:hover .copy-mail-tip,
+.copy-mail:focus-visible .copy-mail-tip,
+.copy-mail[data-copied='true'] .copy-mail-tip {
+  opacity: 1;
+  visibility: visible;
+  transform: translateY(0);
+}
+.copy-mail[data-copied='true'] .copy-mail-tip {
+  background: var(--green);
+}
+.copy-mail[data-copied='true'] .copy-mail-tip::after {
+  border-bottom-color: var(--green);
+}
+.copy-mail[data-copied='true'] .copy-mail-tip-idle {
+  opacity: 0;
+}
+.copy-mail[data-copied='true'] .copy-mail-tip-done {
+  opacity: 1;
+}
+
+@media (hover: none) {
+  /* touch: no hover state, so keep the tooltip for the copied state only */
+  .copy-mail:hover .copy-mail-tip:not(:focus-visible) {
+    visibility: hidden;
+    opacity: 0;
+  }
+  .copy-mail[data-copied='true'] .copy-mail-tip {
+    visibility: visible;
+    opacity: 1;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .copy-mail,
+  .copy-mail-ico,
+  .copy-mail-ico::before,
+  .copy-mail-svg,
+  .copy-mail-tip,
+  .copy-mail-tip > span {
+    transition: none;
+  }
+  .copy-mail:hover .copy-mail-clip {
+    transform: none;
+  }
+}
diff --git a/src/components/home/CopyEmail/CopyEmail.jsx b/src/components/home/CopyEmail/CopyEmail.jsx
new file mode 100644
index 0000000..9319de9
--- /dev/null
+++ b/src/components/home/CopyEmail/CopyEmail.jsx
@@ -0,0 +1,34 @@
+import './CopyEmail.css';
+
+// Email chip with a copy button: the address is always visible (nothing to hunt for), the icon box is amber so it
+// reads as a button, and the clipboard icon swaps to a check once copied.
+// Idea: the "copy to clipboard + tooltip" elements on uiverse.io; markup and styles are our own, on the site's theme vars.
+export default function CopyEmail({ email, copied, onCopy }) {
+  return (
+    <button
+      type="button"
+      onClick={onCopy}
+      data-copied={copied}
+      aria-label={copied ? 'Email address copied' : `Copy email address ${email}`}
+      className="copy-mail font-mono"
+    >
+      <span className="copy-mail-addr">{email}</span>
+      <span className="copy-mail-ico" aria-hidden="true">
+        <svg viewBox="0 0 24 24" className="copy-mail-svg copy-mail-clip" fill="none" stroke="currentColor" strokeWidth="1.7" strokeLinecap="round" strokeLinejoin="round">
+          <rect x="8" y="8" width="12" height="12" rx="2.5" />
+          <path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" />
+        </svg>
+        <svg viewBox="0 0 24 24" className="copy-mail-svg copy-mail-check" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
+          <path d="M5 12.5l4.5 4.5L19 7.5" />
+        </svg>
+      </span>
+      <span className="copy-mail-tip" aria-hidden="true">
+        <span className="copy-mail-tip-idle">click to copy</span>
+        <span className="copy-mail-tip-done">copied!</span>
+      </span>
+      <span role="status" className="sr-only">
+        {copied ? 'Email address copied to clipboard' : ''}
+      </span>
+    </button>
+  );
+}
