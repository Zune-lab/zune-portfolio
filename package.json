{
  "name": "zune-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Zune's personal portfolio: a terminal / code-editor styled site built with React + Tailwind",
  "author": {
    "name": "Zune",
    "url": "https://github.com/Zune-lab"
  },
  "license": "MIT",
  "homepage": "https://zune-lab.github.io/zune-portfolio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zune-lab/zune-portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/Zune-lab/zune-portfolio/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --config system/vite.config.js",
    "build": "vite build --config system/vite.config.js && node system/scripts/spa-404.mjs",
    "preview": "vite preview --config system/vite.config.js",
    "previews": "node system/scripts/make-previews.mjs",
    "lint": "eslint --config system/eslint.config.js .",
    "predev": "node system/scripts/copy-ruffle.mjs",
    "prebuild": "node system/scripts/copy-ruffle.mjs"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  }
}
