From de08ab35ac9aaafd9dd0216ebe8ec712341a724f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 2 Oct 2026 11:12:52 +0000
Subject: [PATCH] calendar art: keep grid layout, stamp today's weekday cell
 (follows the viewer's real date)

---
 src/projects/calendar/Art.css | 27 ++++++++++++++++++++++++++-
 src/projects/calendar/Art.jsx | 22 ++++++++++++++--------
 2 files changed, 40 insertions(+), 9 deletions(-)

diff --git a/src/projects/calendar/Art.css b/src/projects/calendar/Art.css
index 0e71c16..8535d57 100644
--- a/src/projects/calendar/Art.css
+++ b/src/projects/calendar/Art.css
@@ -18,7 +18,14 @@
   background: currentColor;
   opacity: 0.35;
 }
+.cal-head.today {
+  opacity: 1;
+  box-shadow: 0 0 10px -1px currentColor;
+}
 .cal-cell {
+  display: flex;
+  align-items: center;
+  justify-content: center;
   height: 36px;
   border-radius: 7px;
   border: 1px solid var(--line);
@@ -30,12 +37,30 @@
 }
 .cal-cell.today {
   border-color: currentColor;
+  box-shadow: 0 0 16px -5px currentColor;
   animation: cal-blink 2.4s ease-in-out infinite;
 }
+/* con dấu ghi tên thứ: nghiêng nhẹ, "đóng" xuống một lần khi hiện ra */
+.cal-stamp {
+  font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  line-height: 1;
+  padding: 3px 5px;
+  border: 1.5px solid currentColor;
+  border-radius: 4px;
+  transform: rotate(-9deg);
+  animation: cal-stamp-in 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) 0.35s both;
+}
+@keyframes cal-stamp-in {
+  from { opacity: 0; transform: rotate(-9deg) scale(1.9); }
+  to { opacity: 1; transform: rotate(-9deg) scale(1); }
+}
 @keyframes cal-blink {
   0%, 100% { background: color-mix(in srgb, currentColor 10%, transparent); }
   50% { background: color-mix(in srgb, currentColor 45%, transparent); }
 }
 @media (prefers-reduced-motion: reduce) {
-  .cal-cell.today { animation: none; }
+  .cal-cell.today, .cal-stamp { animation: none; }
 }
diff --git a/src/projects/calendar/Art.jsx b/src/projects/calendar/Art.jsx
index 00fe009..a3850f1 100644
--- a/src/projects/calendar/Art.jsx
+++ b/src/projects/calendar/Art.jsx
@@ -1,21 +1,27 @@
 import './Art.css';
 
-// góc lịch: 35 ô (5 tuần x 7 ngày), vài ô sáng lên, 1 ô "hôm nay" nhấp nháy.
-// Không có chữ số nào -> chỉ gợi ý đây là lịch, không lộ nội dung thật.
+// góc lịch: 35 ô (5 tuần x 7 ngày, thứ 2 -> CN), vài ô sáng lên.
+// Ô "hôm nay" nằm ở hàng đầu, ĐÚNG CỘT của thứ hôm nay (thứ 6 -> cột thứ 5) và được đóng một
+// "con dấu" ghi tên thứ; thanh tiêu đề của cột đó cũng sáng lên. Lấy theo ngày thật của máy người xem.
+// Không có số ngày nào -> chỉ gợi ý đây là lịch, không lộ nội dung thật.
+const DAYS = ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'];
 const CELLS = Array.from({ length: 35 }, (_, i) => i);
-// các ô sáng nằm lệch khỏi cột giữa (nơi có nhãn số + tên file) để chữ luôn đọc được
-const ON = new Set([1, 4, 8, 14, 19]);
-const TODAY = 12;
+// các ô sáng trang trí, nằm lệch khỏi cột giữa (nơi có nhãn số + tên file) và tránh hàng đầu (dành cho "hôm nay")
+const ON = new Set([8, 14, 19]);
 
 export default function Art() {
+  const today = (new Date().getDay() + 6) % 7; // getDay(): 0 = CN -> đổi sang 0 = thứ 2
+
   return (
     <div className="cal-art">
       <div className="cal-grid">
-        {Array.from({ length: 7 }, (_, i) => (
-          <span key={`h${i}`} className="cal-head" />
+        {DAYS.map((d, i) => (
+          <span key={d} className={`cal-head${i === today ? ' today' : ''}`} />
         ))}
         {CELLS.map((i) => (
-          <span key={i} className={`cal-cell${ON.has(i) ? ' on' : ''}${i === TODAY ? ' today' : ''}`} />
+          <span key={i} className={`cal-cell${ON.has(i) ? ' on' : ''}${i === today ? ' today' : ''}`}>
+            {i === today && <span className="cal-stamp">{DAYS[today]}</span>}
+          </span>
         ))}
       </div>
     </div>
-- 
2.43.0

