   .lab-btn:hover .lab-btn-ico--zap { animation: none; }
 }
 
+
+/* ===== chuyển động riêng của từng icon (LabIcon.jsx), chỉ chạy khi hover/focus thẻ ===== */
+.lab-icon { overflow: visible; }
+.lab-icon * { transform-box: fill-box; transform-origin: center; }
+
+@media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
+  .lab-card:is(:hover, :focus-visible) .lab-icon--reptile { animation: li-crawl 1.1s ease-in-out infinite; }
+  .lab-card:is(:hover, :focus-visible) .li-leg-a { animation: li-step 0.45s ease-in-out infinite alternate; }
+  .lab-card:is(:hover, :focus-visible) .li-leg-b { animation: li-step 0.45s ease-in-out infinite alternate-reverse; }
+
+  .lab-card:is(:hover, :focus-visible) .li-cathead { transform-origin: 50% 100%; animation: li-tilt 1.2s ease-in-out infinite; }
+  .lab-card:is(:hover, :focus-visible) .li-eye { animation: li-blink 1.8s ease-in-out infinite; }
+
+  .lab-card:is(:hover, :focus-visible) .lab-icon--ghost { animation: li-bob 1.3s ease-in-out infinite; }
+  .lab-card:is(:hover, :focus-visible) .li-gaze { animation: li-gaze 2.2s ease-in-out infinite; }
+
+  .lab-card:is(:hover, :focus-visible) .li-cloth { transform-origin: 50% 0; animation: li-swing 1.3s ease-in-out infinite alternate; }
+
+  .lab-card:is(:hover, :focus-visible) .lab-icon--bug-squash { animation: li-scurry 0.18s linear infinite; }
+  .lab-card:is(:hover, :focus-visible) .li-legs-l { transform-origin: 100% 50%; animation: li-kick 0.2s ease-in-out infinite alternate; }
+  .lab-card:is(:hover, :focus-visible) .li-legs-r { transform-origin: 0 50%; animation: li-kick 0.2s ease-in-out infinite alternate-reverse; }
+  .lab-card:is(:hover, :focus-visible) .li-ant { transform-origin: 50% 100%; animation: li-twitch 0.35s ease-in-out infinite alternate; }
+
+  .lab-card:is(:hover, :focus-visible) .li-flip { animation: li-flip 1.6s ease-in-out infinite; }
+  .lab-card:is(:hover, :focus-visible) .li-back { animation: li-nudge 1.6s ease-in-out infinite; }
+
+  .lab-card:is(:hover, :focus-visible) .li-snake-body { stroke-dasharray: 55 200; animation: li-snake-body 1.6s linear infinite; }
+  .lab-card:is(:hover, :focus-visible) .li-snake-head { animation: li-snake-head 1.6s linear infinite; }
+}
+
+@keyframes li-crawl { 0%, 100% { transform: translate(0, 0) rotate(0); } 50% { transform: translate(2px, -2px) rotate(6deg); } }
+@keyframes li-step { from { transform: rotate(-22deg); } to { transform: rotate(22deg); } }
+
+@keyframes li-tilt { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-9deg); } 75% { transform: rotate(9deg); } }
+@keyframes li-blink { 0%, 40%, 52%, 100% { transform: scaleY(1); } 46% { transform: scaleY(0.1); } }
+
+@keyframes li-bob { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-4px) rotate(3deg); } }
+@keyframes li-gaze { 0%, 100% { transform: translateX(0); } 30% { transform: translateX(-1.2px); } 70% { transform: translateX(1.2px); } }
+
+@keyframes li-swing { from { transform: rotate(-9deg); } to { transform: rotate(9deg); } }
+
+@keyframes li-scurry { 0%, 100% { transform: translateX(-0.6px); } 50% { transform: translateX(0.6px); } }
+@keyframes li-kick { from { transform: rotate(-14deg); } to { transform: rotate(14deg); } }
+@keyframes li-twitch { from { transform: rotate(-12deg); } to { transform: rotate(12deg); } }
+
+@keyframes li-flip { 0%, 100% { transform: scaleX(1); } 35%, 55% { transform: scaleX(0.04); } 80% { transform: scaleX(1); } }
+@keyframes li-nudge { 0%, 100% { transform: translateX(0) rotate(0); } 45% { transform: translateX(-1.2px) rotate(-5deg); } }
+
+/* rắn trườn: thân là đoạn nét trượt dọc đường đi (pathLength=100), đầu đi theo cùng các góc ngoặt */
+@keyframes li-snake-body { from { stroke-dashoffset: 55; } to { stroke-dashoffset: -45; } }
+@keyframes li-snake-head {
+  0%     { transform: translate(-13.5px, 12.5px); }
+  26.25% { transform: translate(-3px, 12.5px); }
+  42.5%  { transform: translate(-3px, 6px); }
+  60%    { transform: translate(-10px, 6px); }
+  75%    { transform: translate(-10px, 0); }
+  100%   { transform: translate(0, 0); }
+}
